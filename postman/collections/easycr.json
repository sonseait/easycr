{
  "info": {
    "name": "EasyCR local admin smoke",
    "description": "Run only against disposable local EasyCR. Supply adminPassword from a local secret variable; never commit it. No workspace publish is required. Image mutations and Docker policy are covered by Go integration/e2e tests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "csrfToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Public health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/healthz"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"liveness\", () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql(\"ok\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Anonymous registry is denied",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/v2/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"no anonymous registry\", () => { pm.response.to.have.status(401); pm.expect(pm.response.headers.get(\"WWW-Authenticate\")).to.include(\"Basic\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{baseUrl}}"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/login",
        "body": {
          "mode": "raw",
          "raw": "{\"password\": \"{{adminPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"login\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"csrfToken\", pm.response.json().csrfToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Session",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/session"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"session authenticated\", () => { pm.response.to.have.status(200); pm.expect(pm.response.json().authenticated).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Repositories",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/repositories?n=50"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"repository page\", () => { pm.response.to.have.status(200); pm.expect(pm.response.json().items).to.be.an(\"array\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Token metadata only",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tokens"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"metadata never exposes credentials\", () => { pm.response.to.have.status(200); for (const t of pm.response.json().items) { pm.expect(t).not.to.have.property(\"hash\"); pm.expect(t).not.to.have.property(\"secret\"); } });"
            ]
          }
        }
      ]
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{baseUrl}}"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/logout"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"logged out\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Session revoked",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/session"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"revoked session\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    }
  ]
}
